#: package/analyses/jjsyndromicplot.description
msgid ""
"Syndromic plots visualize Principal Component Analysis (PCA) loadings using\n"
"a unique triangular design with directional arrows. This visualization "
"method\n"
"was developed by Ferguson et al. (2013) for interpreting complex disease "
"patterns."
msgstr ""

#: jjsyndromicplot/options.description.main
msgid ""
"Syndromic plots visualize Principal Component Analysis (PCA) loadings using\n"
"a unique triangular design with directional arrows. This visualization "
"method\n"
"was developed by Ferguson et al. (2013) for interpreting complex disease "
"patterns.\n"
"\n"
"Arrow width and color represent the magnitude and direction of variable "
"loadings\n"
"on the selected principal component. Only variables with loadings above the\n"
"specified cutoff threshold are displayed.\n"
"\n"
"The triangle center displays the component label and variance accounted for "
"(VAF)."
msgstr ""


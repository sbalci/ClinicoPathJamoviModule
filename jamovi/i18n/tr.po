#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Arc Coloring:</strong> Choose 'Source', 'Target', or 'Gradient' "
"mode to control how arcs are colored when grouping is enabled</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid "<li><strong>Arc Styling:</strong> Fixed width or proportional to weights</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Betweenness Centrality:</strong> Importance as a bridge between "
"network regions. Accounts for weight interpretation mode</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid "<li><strong>Centrality:</strong> Node importance in the network</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Clinical Relevance:</strong> High connectivity doesn't always "
"imply biological significance. Consider domain knowledge when interpreting "
"results</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Closeness Centrality:</strong> Average distance to all other "
"nodes. May be Inf for disconnected graphs (auto-filtered)</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Color Schemes:</strong> Multiple palettes for different node "
"groups</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid "<li><strong>Communities:</strong> Group structure detection</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Connected Components:</strong> Isolated subnetworks may indicate "
"distinct functional modules. Warnings issued for disconnected graphs</li>"
msgstr ""

#: R/sequentialtests.b.R
msgid ""
"<li><strong>Convert post-test odds back to probability</strong>: Post-test P "
"= Odds/(1+Odds)</li>"
msgstr ""

#: R/sequentialtests.b.R
msgid ""
"<li><strong>Convert pre-test probability to odds</strong>: Odds = "
"P/(1-P)</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Data Format:</strong> Each row represents one "
"relationship/connection</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Degree Centrality:</strong> Number of direct connections (hub "
"identification). For weighted networks, uses strength (sum of weights)</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid "<li><strong>Density:</strong> Measure of network connectivity</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Directed Networks:</strong> When 'Directed Network' is enabled, "
"statistics respect edge direction but the arc diagram visualization does NOT "
"display arrows. This is a limitation of the arc plot style</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Disconnected Graphs:</strong> Closeness/betweenness may be "
"unreliable. Inf/NA values are auto-filtered and warnings are issued</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Duplicate Edges:</strong> If not aggregated, density can exceed "
"1.0 and centrality measures may be inflated. Enable 'Aggregate Duplicate "
"Edges' to fix this</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Duplicate Edges:</strong> When 'Aggregate Duplicate Edges' is "
"enabled (recommended), parallel edges are combined by summing weights for "
"accurate density/centrality calculations</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Edge Weight Mode:</strong> 'Strength' mode (default) treats "
"higher weights as stronger connections, suitable for correlations/scores. "
"'Distance' mode treats higher weights as longer paths, suitable for "
"costs/distances</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Edge Weight:</strong> Optional numeric variable for connection "
"strength</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Edge Weights:</strong> Optional numeric values for connection "
"strength</li>"
msgstr ""

#: R/lassologistic.b.R
msgid ""
"<li><strong>Elastic Net</strong>: Combines L1 and L2 penalties; useful when "
"predictors are correlated.</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Group Conflicts:</strong> If a node appears with multiple group "
"labels, warnings are issued and the first occurrence is used</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid "<li><strong>Highest Betweenness:</strong>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid "<li><strong>Highest Degree:</strong>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid "<li><strong>Is Connected:</strong>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Isolated Nodes:</strong> Entities with no connections appear "
"only if referenced; unreachable nodes get zero centrality</li>"
msgstr ""

#: R/lassologistic.b.R
msgid ""
"<li><strong>Lambda</strong>: Controls regularization strength. Higher lambda "
"= fewer variables selected.</li>"
msgstr ""

#: R/lassologistic.b.R
msgid ""
"<li><strong>Lambda</strong>: Controls regularization strength. Higher lambda "
"shrinks every coefficient further toward zero, but none reaches zero, so the "
"number of variables never changes.</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid "<li><strong>Layout:</strong> Choose horizontal or vertical arrangement</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Missing Data:</strong> Rows with missing source/target values "
"are automatically excluded</li>"
msgstr ""

#: R/sequentialtests.b.R
msgid ""
"<li><strong>Multiply odds by likelihood ratio</strong>: Post-test odds = "
"Pre-test odds \\u{00D7} LR</li>"
msgstr ""

#: R/sequentialtests.b.R
msgid "<li><strong>Negative Likelihood Ratio (LR-)</strong>: (1-Se)/Sp</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid "<li><strong>Network Density:</strong>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Network Density:</strong> 0-0.2 (sparse), 0.2-0.5 (moderate), "
">0.5 (dense). Aggregating duplicate edges ensures density ≤ 1.0</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Network Size:</strong> Optimal range is 10-1000 nodes for "
"meaningful analysis</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Node Groups:</strong> Optional categorical variable for color "
"coding</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Node Sizing:</strong> Fixed size or proportional to degree "
"centrality</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid "<li><strong>Node Sorting:</strong> Arrange by name, degree, or group</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Node Variables:</strong> Source and Target must be categorical "
"(factors)</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid "<li><strong>Number of Edges:</strong>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid "<li><strong>Number of Nodes:</strong>"
msgstr ""

#: R/lassologistic.b.R
msgid ""
"<li><strong>Odds Ratio</strong>: exp(coefficient). OR > 1 increases "
"probability of the positive class.</li>"
msgstr ""

#: R/sequentialtests.b.R
msgid "<li><strong>Positive Likelihood Ratio (LR+)</strong>: Se/(1-Sp)</li>"
msgstr ""

#: R/sequentialtests.b.R
msgid "<li><strong>Prevalence (P)</strong>: The pre-test probability of disease</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Self-loops:</strong> Connections from a node to itself are "
"automatically detected and removed</li>"
msgstr ""

#: R/sequentialtests.b.R
msgid ""
"<li><strong>Sensitivity (Se)</strong>: Probability of a positive test in "
"diseased subjects</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Small Networks:</strong> Centrality measures less reliable with "
"< 10 nodes (warning issued)</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Source Node:</strong> Select the variable representing "
"connection origins</li>"
msgstr ""

#: R/sequentialtests.b.R
msgid ""
"<li><strong>Specificity (Sp)</strong>: Probability of a negative test in "
"non-diseased subjects</li>"
msgstr ""

#: R/lassologistic.b.R
msgid ""
"<li><strong>Standardization (default on):</strong> predictors are centered "
"and scaled before fitting, so the penalty treats variables with different "
"units comparably. The Coefficient and Odds Ratio columns of the Selected "
"Variables table are then back-transformed to the <strong>original "
"measurement scale</strong> (per 1 unit of a continuous predictor, or present "
"vs absent for a binary one). The Importance column and the Coefficient Plot "
"stay on the per-standard-deviation scale, which is the quantity that is "
"comparable across predictors with different units.</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Target Node:</strong> Select the variable representing "
"connection destinations</li>"
msgstr ""

#: R/jjarcdiagram.b.R
msgid ""
"<li><strong>Weight Interpretation:</strong> Ensure 'Edge Weight "
"Interpretation' matches your data. Most biological/clinical networks use "
"'Strength' mode</li>"
msgstr ""

#: R/lassologistic.b.R
msgid ""
"<li>Always validate the scoring system on an independent cohort before "
"clinical adoption.</li>"
msgstr ""

#: R/lassologistic.b.R
msgid ""
"<li>Bootstrap optimism correction estimates how much the apparent AUC "
"overestimates true performance.</li>"
msgstr ""

#: R/sequentialtests.b.R
msgid "<li>Combined probability = {first} + {second} = {combined}</li>"
msgstr ""


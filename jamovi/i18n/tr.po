msgid ""
"<br>Welcome to ClinicoPath Correlation Matrix Analysis\n"
"            <br><br>\n"
"            <strong>What this does:</strong> Analyzes relationships between "
"continuous variables (e.g., biomarker levels, lab values, imaging metrics)\n"
"            <br><br>\n"
"            <strong>When to use:</strong> When examining associations "
"between 2+ continuous clinical variables\n"
"            <br><br>\n"
"            <strong>Quick Start:</strong>\n"
"            <br>1. Select 2 or more continuous variables\n"
"            <br>2. Choose correlation method (Pearson for normal data, "
"Spearman for non-normal)\n"
"            <br>3. Optionally group by categorical variable (e.g., tumor "
"grade, treatment group)\n"
"            <br>4. Use partial correlations (3+ variables) to control for "
"confounding effects\n"
"            <br><br>\n"
"            <strong>Correlation Types:</strong>\n"
"            <br>• <strong>Zero-order (regular):</strong> Direct relationship "
"between two variables\n"
"            <br>• <strong>Partial:</strong> Relationship while controlling "
"for all other variables (reduces confounding)\n"
"            <br><br>\n"
"            This function uses ggplot2 and ggstatsplot packages. See "
"documentations <a href = "
"'https://www.indrapatil.com/ggstatsplot/reference/ggcorrmat.html' "
"target='_blank'>ggcorrmat</a> and <a href = "
"'https://www.indrapatil.com/ggstatsplot/reference/grouped_ggcorrmat.html' "
"target='_blank'>grouped_ggcorrmat</a>.\n"
"            <br>\n"
"            Please cite jamovi and the packages as given below.\n"
"            <br><hr>"
msgstr ""

